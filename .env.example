# Copy this file to .env.local and fill in values from your Firebase web app config.
# These are NOT secrets — they end up in the deployed JS bundle.
# Firestore/Storage security rules are what actually protect data.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Phase 3 — Web Push VAPID key from Firebase Console → Project Settings →
# Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=
